<Window x:Class="BetterNotepad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="330"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#E5E5E5">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="BetterNotepad Settings"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="Black"
                   Margin="0,0,0,18"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Theme"
                       Foreground="Black"
                       FontWeight="Bold"/>

            <ComboBox x:Name="ThemeBox"
                      Height="28"
                      Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Font Size"
                       Foreground="Black"
                       FontWeight="Bold"/>

            <Slider x:Name="FontSizeSlider"
                    Minimum="10"
                    Maximum="28"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Margin="0,4,0,0"/>

            <TextBlock x:Name="FontSizeText"
                       Foreground="Black"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <CheckBox x:Name="AutoSaveBox"
                  Grid.Row="3"
                  Content="Enable AutoSave"
                  Foreground="Black"
                  Margin="0,0,0,8"/>

        <CheckBox x:Name="LineNumbersBox"
                  Grid.Row="4"
                  Content="Show line numbers in CodeEditor"
                  Foreground="Black"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button Content="Open Themes Folder"
                    Width="140"
                    Margin="0,0,8,0"
                    Click="OpenThemesFolder"/>

            <Button Content="Cancel"
                    Width="80"
                    Margin="0,0,8,0"
                    Click="CancelSettings"/>

            <Button Content="Save"
                    Width="80"
                    Click="SaveSettings"/>
        </StackPanel>
    </Grid>
</Window>